# انسخ هذا الملف إلى .env.production خارج المستودع، ثم استبدل القيم.
# يجب أن يشير DNS A/AAAA للنطاق إلى عنوان خادمك وأن يكون المنفذان 80 و443 متاحين.
YTRANA_DOMAIN=social.example.com
YTRANA_PUBLIC_URL=https://social.example.com
SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
MAX_UPLOAD_MB=5
MAX_REEL_MB=20

# إعداد Brevo اختياري لرموز OTP؛ يلزم مفتاح API وبريد مرسل موثّق لدى Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Ytrana

# إعداد Twilio Verify اختياري؛ يلزم حساب Twilio وخدمة Verify.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
