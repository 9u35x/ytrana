# Ytrana Backend Environment Variables
APP_NAME=Ytrana
ENV=development
SECRET_KEY=change_this_to_a_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./ytrana.db
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
MAX_REEL_MB=20
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# البريد الإلكتروني OTP عبر Brevo (اختياري؛ استخدم عنوان مرسل موثّقاً في Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Ytrana

# SMS OTP عبر Twilio Verify (اختياري؛ لا تُرسل رسائل حتى يبدأ المستخدم التحقق)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
